create table huespedes (
    id_huesped number (10),
    nombre varchar2 (50) not null,
    apellido_paterno varchar2 (50) not null,
    apellido_materno varchar2 (50) not null,
    email varchar2 (100) not null,
    telefono varchar2 (10) not null,
    documento varchar2 (30) not null,
    nacionalidad varchar2 (30) not null,
    estado_registro varchar2 (30) not null,
    constraint check_documento check (
        documento in (
            'CREDENCIAL',
            'PASAPORTE',
            'CARTILLA_MILITAR',
            'CURP'
        )
    ),
    constraint huesped_telefono_chk check (
        regexp_like(telefono, '^[0-9]{10}$')
    ),
    constraint check_huesped_estado_registro check (
        estado_registro in ('ACTIVO', 'ELIMINADO')
    )
);